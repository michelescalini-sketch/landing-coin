{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing-buy-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "analytics_engine_datasets": [
    {
      "binding": "BUY_ANALYTICS",
      "dataset": "landing_buy_funnel"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
