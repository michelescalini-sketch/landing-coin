{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landing-lander-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "secrets": {
    "required": ["SOLANA_RPC_URL"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "landing-lander-registry",
      "database_id": "a7318423-07de-4eb0-9d59-6d9978212b8d",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
